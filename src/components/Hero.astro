---
import Button from "./Button.astro";
---

<section class="hero">
	<div class="hero__inner container">
		<div class="hero__content">
			<div class="hero__text">
				<div class="hero__headline-wrap">
					<span class="hero__tag" aria-hidden="false">
						<img src="/assets/images/material-symbols-diamond.svg" alt="" width="24" height="24" />
						für hochpreisige Dienstleistungen
					</span>
					<h1 class="hero__headline">Neukunden gewinnen leicht gemacht</h1>
				</div>
				<p class="hero__description">
					Du denkst, es reicht aus, der Beste zu sein – aber dann merkst du: Kunden kaufen nicht beim Besten, sondern beim sichtbarsten Anbieter.
				</p>
			</div>
			<Button label="ich will wachsen" />
		</div>

		<div class="hero__visual">
			<div class="hero__card">
				<div class="hero__card-skeleton" aria-hidden="true">
					<div class="hero__skeleton-row"><span class="hero__skeleton-dot"></span><span class="hero__skeleton-bar"></span><span class="hero__skeleton-dot"></span></div>
					<div class="hero__skeleton-row"><span class="hero__skeleton-dot"></span><span class="hero__skeleton-bar"></span><span class="hero__skeleton-dot"></span></div>
					<div class="hero__skeleton-row"><span class="hero__skeleton-dot"></span><span class="hero__skeleton-bar"></span><span class="hero__skeleton-dot"></span></div>
				</div>
				<span class="hero__card-corner hero__card-corner--tl" aria-hidden="true"></span>
				<span class="hero__card-corner hero__card-corner--tr" aria-hidden="true"></span>
				<span class="hero__card-corner hero__card-corner--bl" aria-hidden="true"></span>
				<span class="hero__card-corner hero__card-corner--br" aria-hidden="true"></span>
				<img
					src="/assets/images/gluck-kann-man-nicht-kaufen-ein-bike-schon1.png"
					alt="Screenshot: 24 qualifizierte Anfragen diesen Monat"
					width="703"
					height="878"
					class="hero__card-photo"
				/>
			</div>
			<div class="hero__polaroid">
				<img src="/assets/images/image1.png" alt="" width="262" height="165" />
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		width: 100%;
		background-color: var(--color-neutral-2);
		overflow: clip;
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 5em;
		padding-top: 6.8125em;
		padding-bottom: 4em;
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5em;
		max-width: 46.4375em;
	}

	.hero__text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5em;
	}

	.hero__headline-wrap {
		position: relative;
		display: flex;
		justify-content: center;
	}

	.hero__headline {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 4.5em;
		line-height: 1.111;
		letter-spacing: -1.8px;
		color: var(--color-primary);
		text-align: center;
		max-width: 15.7em;
	}

	.hero__tag {
		position: absolute;
		top: -2.5em;
		left: 0.5em;
		display: inline-flex;
		align-items: center;
		gap: 0.625em;
		padding: 0.75em 1.5em;
		background-color: var(--color-accent);
		border-radius: var(--radius-xl);
		transform: rotate(-4deg);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1em;
		line-height: 1.75;
		letter-spacing: -0.4px;
		color: var(--color-primary);
		white-space: nowrap;
	}

	.hero__tag img {
		width: 1.5em;
		height: 1.5em;
	}

	.hero__description {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 1.25em;
		line-height: 1.4;
		letter-spacing: -0.16px;
		color: var(--color-neutral-1);
		text-align: center;
		max-width: 34.7em;
	}

	.hero__visual {
		position: relative;
		width: 100%;
		max-width: 36em;
	}

	.hero__card {
		width: 100%;
		aspect-ratio: 576 / 756;
		border-radius: var(--radius-lg);
		background-color: var(--color-accent);
		overflow: hidden;
		position: relative;
	}

	.hero__card-skeleton {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
	}

	.hero__skeleton-row {
		position: absolute;
		left: 0;
		width: 100%;
		height: 3.524em;
		display: flex;
		align-items: center;
		gap: 0;
	}

	.hero__skeleton-row:nth-child(1) {
		top: 22.125em;
	}

	.hero__skeleton-row:nth-child(2) {
		top: 29.269em;
	}

	.hero__skeleton-row:nth-child(3) {
		top: 36.434em;
	}

	.hero__skeleton-dot {
		flex-shrink: 0;
		width: 3.524em;
		height: 3.524em;
		background-color: rgba(17, 25, 12, 0.2);
	}

	.hero__skeleton-bar {
		flex: 1 0 0;
		height: 3.524em;
		background-color: rgba(17, 25, 12, 0.2);
	}

	.hero__card-corner {
		position: absolute;
		width: 1em;
		height: 1em;
		border-radius: 50%;
		background-color: #11190c;
		z-index: 2;
	}

	.hero__card-corner--tl {
		top: 1.5em;
		left: 1.5em;
	}

	.hero__card-corner--tr {
		top: 1.5em;
		right: 1.5em;
	}

	.hero__card-corner--bl {
		bottom: 1.5em;
		left: 1.5em;
	}

	.hero__card-corner--br {
		bottom: 1.5em;
		right: 1.5em;
	}

	.hero__card-photo {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 122%;
		height: 116%;
		max-width: none;
		object-fit: contain;
		z-index: 1;
	}

	.hero__polaroid {
		position: absolute;
		left: -4%;
		bottom: 6%;
		width: 45%;
		transform: rotate(-15deg);
		border-radius: var(--radius-sm);
		overflow: hidden;
		box-shadow: var(--shadow-card);
	}

	.hero__polaroid img {
		width: 100%;
		height: auto;
		display: block;
		object-fit: cover;
	}

	@media (max-width: 991px) {
		.hero__headline {
			font-size: 3.5em;
		}
	}

	@media (max-width: 767px) {
		.hero__inner {
			gap: 3em;
			padding-top: 3em;
			padding-bottom: 2em;
		}

		.hero__headline {
			font-size: 2.5em;
		}

		.hero__tag {
			position: static;
			transform: rotate(-2deg);
			margin-bottom: 1em;
		}

		.hero__headline-wrap {
			flex-direction: column;
			align-items: center;
		}
	}
</style>
