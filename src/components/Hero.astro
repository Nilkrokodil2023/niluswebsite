---
import Button from "./Button.astro";
---

<section class="hero">
	<div class="hero__pattern" aria-hidden="true">
		<span class="hero__pattern-tile" style="left: 0em; top: 0em;"></span>
		<span class="hero__pattern-tile" style="left: 22.857em; top: 0em;"></span>
		<span class="hero__pattern-tile" style="left: 45.714em; top: 0em;"></span>
		<span class="hero__pattern-tile" style="left: 68.571em; top: 0em;"></span>
		<span class="hero__pattern-tile" style="left: 11.429em; top: 11.429em;"></span>
		<span class="hero__pattern-tile" style="left: 34.286em; top: 11.429em;"></span>
		<span class="hero__pattern-tile" style="left: 57.143em; top: 11.429em;"></span>
		<span class="hero__pattern-tile" style="left: 0em; top: 22.858em;"></span>
		<span class="hero__pattern-tile" style="left: 22.857em; top: 22.858em;"></span>
		<span class="hero__pattern-tile" style="left: 45.714em; top: 22.858em;"></span>
		<span class="hero__pattern-tile" style="left: 68.571em; top: 22.858em;"></span>
	</div>
	<div class="hero__inner container">
		<div class="hero__content">
			<div class="hero__text">
				<div class="hero__headline-wrap">
					<span class="hero__tag" aria-hidden="false" data-hero-badge>
						<img src="/assets/images/material-symbols-diamond.svg" alt="" width="24" height="24" />
						für hochpreisige Dienstleistungen
					</span>
					<h1 class="hero__headline" data-hero-heading>Neukunden gewinnen leicht gemacht</h1>
				</div>
				<p class="hero__description">
					Du denkst, es reicht aus, der Beste zu sein – aber dann merkst du: Kunden kaufen nicht beim Besten, sondern beim sichtbarsten Anbieter.
				</p>
			</div>
			<Button label="ich will wachsen" sweep contact />
		</div>

		<div class="hero__visual">
			<div class="hero__card" data-hero-card>
				<div class="hero__card-skeleton" aria-hidden="true">
					<div class="hero__skeleton-row"><span class="hero__skeleton-dot"></span><span class="hero__skeleton-bar"></span><span class="hero__skeleton-dot"></span></div>
					<div class="hero__skeleton-row"><span class="hero__skeleton-dot"></span><span class="hero__skeleton-bar"></span><span class="hero__skeleton-dot"></span></div>
					<div class="hero__skeleton-row"><span class="hero__skeleton-dot"></span><span class="hero__skeleton-bar"></span><span class="hero__skeleton-dot"></span></div>
				</div>
				<span class="hero__card-corner hero__card-corner--tl" aria-hidden="true"></span>
				<span class="hero__card-corner hero__card-corner--tr" aria-hidden="true"></span>
				<span class="hero__card-corner hero__card-corner--bl" aria-hidden="true"></span>
				<span class="hero__card-corner hero__card-corner--br" aria-hidden="true"></span>
				<img
					src="/assets/images/gluck-kann-man-nicht-kaufen-ein-bike-schon1.png"
					alt="Screenshot: 24 qualifizierte Anfragen diesen Monat"
					width="703"
					height="878"
					class="hero__card-photo"
				/>
			</div>
			<div class="hero__polaroid" data-hero-card>
				<div
					class="trustmarkt-widget"
					data-company-id="a9GXlO10onGawmQADqnv"
					data-widget-id="eWzmbJD12BLMvV9aoEAx"
					style="height: 168px;"
				>
					<a rel="dofollow" href="https://agenturmarkt.de/agentur/nilufar-layer-muenchen" aria-label="Agenturmarkt Profil von Nilufar Layer"></a>
				</div>
			</div>
			<div class="hero__note" data-hero-card>
				<p class="hero__note-title">Täglich qualifizierte Anfragen</p>
				<p class="hero__note-text">Mit einer Website und Werbeanzeigen, die 24/7 für dich arbeiten.</p>
			</div>
		</div>
	</div>
</section>

<script>
	import gsap from "gsap";
	import { SplitText } from "gsap/SplitText";

	gsap.registerPlugin(SplitText);

	function initHeroEntrance() {
		const heading = document.querySelector<HTMLElement>("[data-hero-heading]");
		const badge = document.querySelector<HTMLElement>("[data-hero-badge]");
		const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-hero-card]"));
		const all = [heading, badge, ...cards].filter(Boolean) as HTMLElement[];
		if (!all.length) return;

		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (reduce) {
			gsap.set(all, { clearProps: "all", opacity: 1 });
			return;
		}

		document.fonts.ready.then(() => {
			gsap.set(all, { opacity: 1 });

			const headingSplit = heading ? new SplitText(heading, { type: "words" }) : null;

			if (headingSplit) {
				gsap.from(headingSplit.words, {
					yPercent: -100,
					opacity: 0,
					ease: "sine.out",
					duration: 0.8,
					stagger: { amount: 0.4 },
					onComplete: () => gsap.set(headingSplit.words, { clearProps: "transform,opacity" }),
				});
			}

			if (badge) {
				gsap.from(badge, {
					opacity: 0,
					duration: 0.7,
					ease: "power3.out",
				});
			}

			if (cards.length) {
				gsap.from(cards, {
					opacity: 0,
					yPercent: 15,
					duration: 0.7,
					ease: "power3.out",
					stagger: { amount: 0.3 },
					onComplete: () => gsap.set(cards, { clearProps: "transform" }),
				});
			}
		});
	}

	initHeroEntrance();
</script>

<style>
	.hero {
		position: relative;
		width: 100%;
		background-color: var(--color-neutral-2);
		overflow: clip;
	}

	.hero__pattern {
		position: absolute;
		left: 50%;
		top: 39.294em;
		width: 80em;
		height: 34.286em;
		transform: translateX(-50%);
		z-index: 0;
	}

	.hero__pattern-tile {
		position: absolute;
		width: 11.429em;
		height: 11.429em;
		background-color: var(--color-bg-muted);
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 5em;
		padding-top: 6.8125em;
		padding-bottom: 4em;
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5em;
		max-width: 46.4375em;
	}

	.hero__text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5em;
	}

	.hero__headline-wrap {
		position: relative;
		display: flex;
		justify-content: center;
	}

	.hero__headline {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 4.5em;
		line-height: 1.111;
		letter-spacing: -1.8px;
		color: var(--color-primary);
		text-align: center;
		max-width: 15.7em;
	}

	.hero__tag {
		position: absolute;
		top: -2.5em;
		left: 0.5em;
		display: inline-flex;
		align-items: center;
		gap: 0.625em;
		padding: 0.75em 1.5em;
		background-color: var(--color-accent);
		border-radius: var(--radius-xl);
		transform: rotate(-4deg);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1em;
		line-height: 1.75;
		letter-spacing: -0.4px;
		color: var(--color-primary);
		white-space: nowrap;
	}

	.hero__tag img {
		width: 1.5em;
		height: 1.5em;
	}

	.hero__description {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 1.25em;
		line-height: 1.4;
		letter-spacing: -0.16px;
		color: var(--color-neutral-1);
		text-align: center;
		max-width: 34.7em;
	}

	.hero__visual {
		position: relative;
		width: 100%;
		max-width: 36em;
	}

	.hero__card {
		width: 100%;
		aspect-ratio: 576 / 756;
		border-radius: var(--radius-lg);
		background-color: var(--color-accent);
		overflow: hidden;
		position: relative;
	}

	.hero__card-skeleton {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
	}

	.hero__skeleton-row {
		position: absolute;
		left: 0;
		width: 100%;
		height: 3.524em;
		display: flex;
		align-items: center;
		gap: 0;
	}

	.hero__skeleton-row:nth-child(1) {
		top: 22.125em;
	}

	.hero__skeleton-row:nth-child(2) {
		top: 29.269em;
	}

	.hero__skeleton-row:nth-child(3) {
		top: 36.434em;
	}

	.hero__skeleton-dot {
		flex-shrink: 0;
		width: 3.524em;
		height: 3.524em;
		background-color: rgba(17, 25, 12, 0.2);
	}

	.hero__skeleton-bar {
		flex: 1 0 0;
		height: 3.524em;
		background-color: rgba(17, 25, 12, 0.2);
	}

	.hero__card-corner {
		position: absolute;
		width: 1em;
		height: 1em;
		border-radius: 50%;
		background-color: #11190c;
		z-index: 2;
	}

	.hero__card-corner--tl {
		top: 1.5em;
		left: 1.5em;
	}

	.hero__card-corner--tr {
		top: 1.5em;
		right: 1.5em;
	}

	.hero__card-corner--bl {
		bottom: 1.5em;
		left: 1.5em;
	}

	.hero__card-corner--br {
		bottom: 1.5em;
		right: 1.5em;
	}

	.hero__card-photo {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 122%;
		height: 116%;
		max-width: none;
		object-fit: contain;
		z-index: 1;
	}

	.hero__polaroid {
		position: absolute;
		left: -8%;
		top: -6%;
		width: 42%;
		transform: rotate(-8deg);
		border-radius: var(--radius-sm);
		overflow: hidden;
		box-shadow: var(--shadow-card);
		z-index: 3;
	}

	.hero__note {
		position: absolute;
		right: -8%;
		bottom: 10%;
		width: 46%;
		padding: 1.25em 1.5em;
		background-color: white;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-card);
		transform: rotate(6deg);
		z-index: 3;
	}

	.hero__note-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.125em;
		line-height: 1.3;
		color: var(--color-primary);
	}

	.hero__note-text {
		margin-top: 0.5em;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 0.875em;
		line-height: 1.4;
		color: var(--color-text-secondary);
	}

	@media (max-width: 991px) {
		.hero__headline {
			font-size: 3.5em;
		}
	}

	@media (max-width: 767px) {
		.hero__inner {
			gap: 3em;
			padding-top: 3em;
			padding-bottom: 2em;
		}

		.hero__headline {
			font-size: 2.5em;
		}

		.hero__tag {
			position: static;
			margin-bottom: 1em;
			transform: rotate(-2deg);
		}

		.hero__headline-wrap {
			flex-direction: column;
			align-items: center;
		}

		.hero__polaroid {
			left: 0.5em;
			width: 46%;
		}

		.hero__note {
			right: 0.5em;
			bottom: 9%;
			width: 54%;
			padding: 0.5em 0.75em;
		}

		.hero__note-title {
			font-size: 0.75em;
		}

		.hero__note-text {
			margin-top: 0.25em;
			font-size: 0.625em;
			line-height: 1.3;
		}
	}
</style>
