---
import Button from "./Button.astro";

const links = [
	{ label: "Methode", href: "#methode" },
	{ label: "Referenzen", href: "#referenzen" },
	{ label: "Über mich", href: "#ueber-mich" },
	{ label: "FAQ", href: "#faq" },
];
---

<header class="navbar">
	<div class="navbar__inner container">
		<nav class="navbar__nav">
			<a href="/" class="navbar__logo" aria-label="Nilufar Layer, Home">
				<span class="navbar__logo-icon" aria-hidden="true">
					<img src="/assets/images/vector.svg" alt="" class="navbar__logo-shape navbar__logo-shape--a" />
					<img src="/assets/images/vector1.svg" alt="" class="navbar__logo-shape navbar__logo-shape--b" />
					<img src="/assets/images/vector2.svg" alt="" class="navbar__logo-shape navbar__logo-shape--c" />
				</span>
				<span class="navbar__logo-text">Nilufar Layer</span>
			</a>

			<input type="checkbox" id="nav-toggle" class="navbar__toggle-input" />

			<div class="navbar__links">
				{links.map((link) => <a href={link.href} class="navbar__link">{link.label}</a>)}
				<Button label="Zusammenarbeit anfragen" size="sm" contact />
			</div>

			<label for="nav-toggle" class="navbar__burger" aria-label="Menü öffnen">
				<span></span>
				<span></span>
				<span></span>
			</label>
		</nav>
	</div>
</header>

<style>
	.navbar {
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		background-color: var(--color-neutral-2);
		padding-block: 1.5em;
	}

	.navbar__nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		border-radius: var(--radius-pill);
		position: relative;
	}

	.navbar__logo {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
	}

	.navbar__logo-icon {
		position: relative;
		display: inline-block;
		width: 1.875em;
		height: 1.875em;
		flex-shrink: 0;
	}

	.navbar__logo-shape {
		position: absolute;
	}

	.navbar__logo-shape--a {
		left: 0.791em;
		top: 0.768em;
		width: 1em;
		height: 1em;
		z-index: 1;
	}

	.navbar__logo-shape--b {
		left: 0.187em;
		top: 0.163em;
		width: 1.546em;
		height: 1.545em;
		z-index: 2;
	}

	.navbar__logo-shape--c {
		left: 0.129em;
		top: 0.104em;
		width: 1.002em;
		height: 1.003em;
		z-index: 3;
	}

	.navbar__logo-text {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 1.25em;
		color: var(--color-primary);
		line-height: 1.2;
	}

	.navbar__links {
		display: flex;
		align-items: center;
		gap: 1em;
	}

	.navbar__link {
		padding: 0.75em;
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 1em;
		line-height: 1.5;
		color: var(--color-primary);
		text-decoration: none;
		white-space: nowrap;
	}

	.navbar__link:hover {
		opacity: 0.7;
	}

	.navbar__toggle-input {
		display: none;
	}

	.navbar__burger {
		display: none;
		flex-direction: column;
		gap: 5px;
		cursor: pointer;
		padding: 0.5em;
	}

	.navbar__burger span {
		display: block;
		width: 22px;
		height: 2px;
		background-color: var(--color-primary);
	}

	@media (max-width: 991px) {
		.navbar__burger {
			display: flex;
		}

		.navbar__links {
			display: none;
			position: absolute;
			top: calc(100% + 0.5em);
			right: 0;
			left: 0;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5em;
			background-color: var(--color-neutral-2);
			border-radius: var(--radius-md);
			padding: 1em;
			z-index: 20;
		}

		.navbar__toggle-input:checked ~ .navbar__links {
			display: flex;
		}
	}
</style>
