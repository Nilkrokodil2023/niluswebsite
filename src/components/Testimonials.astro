---
const testimonials = [
	{
		image: "/assets/images/bildschirmfoto20260723-um1445081.png",
		alt: "Referenzprojekt Screenshot",
		blocks: [
			{ label: "Problem:", body: "Es gab bereits viele Anfragen für den Service der individuellen Produktion von Verpackungen. Die Anzahl sollte erhöht und gleichzeitig die Leadqualität erhalten werden." },
			{ label: "Lösung:", body: "Intensive Zielgruppenrecherche und Erstellung einer verkaufsstarken Landingpage mit diesen Insights. Erstellung von Werbekampagnen auf Google und Meta zur Neukundengewinnung." },
			{ label: "Ergebnis:", body: "Die neue Landingpage wurde A/B-getestet und erbrachte eine 23% Verbesserung der Conversionrate bei außerordentlich guter Leadqualität." },
		],
		name: "Holger Kehr",
		title: "Geschäftsführer der Verpackungswelt GmbH",
		objectPosition: "center",
	},
	{
		image: "/assets/images/gabriele-wahl-multerer.jpg",
		alt: "Gabriele Wahl-Multerer",
		blocks: [
			{ label: "Problem:", body: "Zu wenig qualifizierte Anfragen – das Angebot war stark, doch die Sichtbarkeit und Ansprache der richtigen Zielgruppe fehlten." },
			{ label: "Lösung:", body: "Eine intensive Zielgruppenanalyse bildete die Basis für eine verkaufspsychologisch optimierte Landingpage. Darauf aufbauend wurden gezielte Werbekampagnen auf Google und Meta ausgesteuert, um die richtige Zielgruppe zur richtigen Zeit mit der richtigen Botschaft zu erreichen." },
			{ label: "Ergebnis:", body: "Deutliche Verbesserung der Conversion Rate um 34% und somit spürbare Erhöhung der Direktbuchungen." },
		],
		name: "Gabriele Wahl-Multerer",
		title: "Geschäftsführerin Park am See Nattika",
		objectPosition: "center top",
	},
	{
		image: "/assets/images/christian-prem.webp",
		alt: "Christian Prem",
		blocks: [
			{ label: "Problem:", body: "Zu wenig Sichtbarkeit und Interaktion auf Social Media – das Potenzial der Marke (3D-Bike-Fitting, Premium-E-Bikes) wurde online nicht ausgeschöpft, dazu Optimierungsbedarf bei den laufenden Werbekampagnen." },
			{ label: "Lösung:", body: "Erstellung einer Landingpage für das Premiumangebot. Parallel dazu wurden die bestehenden Google- und Meta-Kampagnen analysiert und optimiert, um die Zielgruppe gezielter und wirkungsvoller anzusprechen." },
			{ label: "Ergebnis:", body: "Gesteigerte Markenpräsenz auf Social Media und Positionierung als Experte in der Nische. Steigerung der Conversionrate um 29% und Anstieg der Verkäufe online sowie im Store." },
		],
		name: "Christian Prem",
		title: "Geschäftsführer eBike PREMium",
		objectPosition: "center 20%",
		zoom: true,
	},
];
---

<section class="testimonials">
	<div class="testimonials__inner container">
		<h2 class="testimonials__headline">Was meine Kunden <span class="testimonials__accent">sagen</span></h2>

		<div class="testimonials__slider" data-slider>
			<div class="testimonials__track" data-track style={`--slide-count: ${testimonials.length}`}>
				{testimonials.map((t) => (
					<div class="testimonials__slide">
						<div class="testimonials__content">
							<div class="testimonials__image">
								<img
									src={t.image}
									alt={t.alt}
									width="600"
									height="700"
									style={`object-position: ${t.objectPosition}; ${t.zoom ? "transform: scale(1.55);" : ""}`}
								/>
							</div>

							<div class="testimonials__text">
								<svg class="testimonials__quote-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
									<path d="M26 16C18.268 16 12 22.268 12 30v18h18V30h-9c0-5.523 4.477-10 10-10v-4zm26 0c-7.732 0-14 6.268-14 14v18h18V30h-9c0-5.523 4.477-10 10-10v-4z" fill="currentColor"/>
								</svg>

								<div class="testimonials__quote">
									{t.blocks.map((b) => (
										<div class="testimonials__quote-block">
											<p class="testimonials__quote-label">{b.label}</p>
											<p class="testimonials__quote-body">{b.body}</p>
										</div>
									))}
								</div>

								<div class="testimonials__author">
									<p class="testimonials__author-name">{t.name}</p>
									<p class="testimonials__author-title">{t.title}</p>
								</div>
							</div>
						</div>
					</div>
				))}
			</div>

			<div class="testimonials__controls">
				<button type="button" class="testimonials__arrow" data-prev aria-label="Vorheriges Testimonial">
					<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</button>
				<div class="testimonials__dots" data-dots>
					{testimonials.map((_, i) => (
						<button type="button" class="testimonials__dot" data-dot={i} aria-label={`Testimonial ${i + 1}`}></button>
					))}
				</div>
				<button type="button" class="testimonials__arrow" data-next aria-label="Nächstes Testimonial">
					<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	function initTestimonialSliders() {
		document.querySelectorAll<HTMLElement>("[data-slider]").forEach((slider) => {
			const track = slider.querySelector<HTMLElement>("[data-track]");
			const slides = slider.querySelectorAll<HTMLElement>(".testimonials__slide");
			const dots = slider.querySelectorAll<HTMLElement>("[data-dot]");
			const prevBtn = slider.querySelector<HTMLElement>("[data-prev]");
			const nextBtn = slider.querySelector<HTMLElement>("[data-next]");
			let index = 0;

			function goTo(i: number) {
				index = (i + slides.length) % slides.length;
				if (track) track.style.transform = `translateX(-${index * 100}%)`;
				dots.forEach((dot, di) => dot.classList.toggle("is-active", di === index));
			}

			prevBtn?.addEventListener("click", () => goTo(index - 1));
			nextBtn?.addEventListener("click", () => goTo(index + 1));
			dots.forEach((dot, di) => dot.addEventListener("click", () => goTo(di)));

			goTo(0);
		});
	}

	initTestimonialSliders();
</script>

<style>
	.testimonials {
		width: 100%;
		background-color: var(--color-primary);
		padding-block: 6.25em;
	}

	.testimonials__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4.5em;
	}

	.testimonials__headline {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 3.75em;
		line-height: 1.2;
		letter-spacing: -1.5px;
		color: var(--color-text-white);
		text-align: center;
	}

	.testimonials__accent {
		color: var(--color-accent);
	}

	.testimonials__slider {
		width: 100%;
		max-width: 61em;
		display: flex;
		flex-direction: column;
		gap: 2.5em;
		overflow: hidden;
	}

	.testimonials__track {
		display: flex;
		width: 100%;
		transition: transform 0.5s ease;
	}

	.testimonials__slide {
		flex: 0 0 100%;
		min-width: 0;
	}

	.testimonials__content {
		display: flex;
		align-items: center;
		gap: 3.6875em;
		width: 100%;
	}

	.testimonials__image {
		flex-shrink: 0;
		width: 22em;
		aspect-ratio: 4 / 5;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background-color: var(--color-primary);
		transform: translateZ(0);
	}

	.testimonials__image img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		border-radius: var(--radius-lg);
	}

	.testimonials__text {
		flex: 1 0 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 2.5em;
	}

	.testimonials__quote-icon {
		width: 4em;
		height: 4em;
		color: var(--color-accent);
	}

	.testimonials__quote {
		display: flex;
		flex-direction: column;
		gap: 1.25em;
	}

	.testimonials__quote-block {
		display: flex;
		flex-direction: column;
		gap: 0.375em;
	}

	.testimonials__quote-label {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.25em;
		line-height: 1.4;
		letter-spacing: -0.5px;
		color: var(--color-accent);
	}

	.testimonials__quote-body {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 1.125em;
		line-height: 1.55;
		letter-spacing: -0.16px;
		color: var(--color-text-white);
	}

	.testimonials__author-name {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 1.25em;
		line-height: 1.4;
		letter-spacing: -0.16px;
		color: var(--color-text-white);
	}

	.testimonials__author-title {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 0.875em;
		line-height: 1.429;
		letter-spacing: -0.112px;
		color: var(--color-neutral-3);
	}

	.testimonials__controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5em;
	}

	.testimonials__arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75em;
		height: 2.75em;
		flex-shrink: 0;
		background-color: transparent;
		border: 1px solid var(--color-neutral-6);
		border-radius: 50%;
		color: var(--color-text-white);
		cursor: pointer;
	}

	.testimonials__arrow:hover {
		background-color: var(--color-neutral-6);
	}

	.testimonials__arrow svg {
		width: 1.25em;
		height: 1.25em;
	}

	.testimonials__dots {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}

	.testimonials__dot {
		width: 0.5em;
		height: 0.5em;
		border-radius: 50%;
		background-color: var(--color-neutral-6);
		border: none;
		cursor: pointer;
		padding: 0;
	}

	.testimonials__dot.is-active {
		width: 2.5em;
		border-radius: 1em;
		background-color: var(--color-accent);
	}

	@media (max-width: 991px) {
		.testimonials__headline {
			font-size: 3em;
		}

		.testimonials__content {
			flex-direction: column;
		}

		.testimonials__image {
			width: 100%;
			max-width: 20em;
		}
	}

	@media (max-width: 767px) {
		.testimonials {
			padding-block: 3em;
		}

		.testimonials__headline {
			font-size: 2.25em;
		}

		.testimonials__quote-body {
			font-size: 1em;
		}
	}
</style>
