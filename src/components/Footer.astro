<script>
	function initModals() {
		const modals = document.querySelectorAll<HTMLElement>("[data-modal]");
		if (!modals.length) return;

		function closeModal(modal: HTMLElement) {
			modal.hidden = true;
			document.body.style.overflow = "";
		}

		function openModal(modal: HTMLElement) {
			modal.hidden = false;
			document.body.style.overflow = "hidden";
		}

		modals.forEach((modal) => {
			modal.querySelectorAll<HTMLElement>("[data-modal-close]").forEach((el) => {
				el.addEventListener("click", () => closeModal(modal));
			});
		});

		document.querySelectorAll<HTMLElement>("[data-modal-open]").forEach((trigger) => {
			trigger.addEventListener("click", () => {
				const name = trigger.getAttribute("data-modal-open");
				const modal = document.querySelector<HTMLElement>(`[data-modal="${name}"]`);
				if (modal) openModal(modal);
			});
		});

		document.addEventListener("keydown", (e) => {
			if (e.key !== "Escape") return;
			modals.forEach((modal) => {
				if (!modal.hidden) closeModal(modal);
			});
		});
	}

	initModals();

	function initPhoneForm() {
		const form = document.querySelector<HTMLFormElement>("[data-phone-form]");
		if (!form) return;

		form.addEventListener("submit", (e) => {
			e.preventDefault();
			const input = form.querySelector<HTMLInputElement>("[data-phone-input]");
			const phone = input?.value.trim();
			if (!phone) return;

			if ((window as any).fbq) {
				(window as any).fbq("track", "Lead");
			}

			const subject = encodeURIComponent("Rückruf-Anfrage");
			const body = encodeURIComponent(`Bitte ruft mich zurück.\n\nMeine Telefonnummer: ${phone}`);
			window.location.href = `mailto:hello@nilufarlayer.de?subject=${subject}&body=${body}`;
		});
	}

	initPhoneForm();
</script>

