---
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer__inner container">
		<div class="footer__links">
			<a href="/" class="footer__logo" aria-label="Nilufar Layer, Home">
				<span class="footer__logo-icon" aria-hidden="true">
					<img src="/assets/images/vector.svg" alt="" class="footer__logo-shape footer__logo-shape--a" />
					<img src="/assets/images/vector1.svg" alt="" class="footer__logo-shape footer__logo-shape--b" />
					<img src="/assets/images/vector2.svg" alt="" class="footer__logo-shape footer__logo-shape--c" />
				</span>
				<span class="footer__logo-text">Nilufar Layer</span>
			</a>

			<nav class="footer__nav" aria-label="Rechtliches">
				<p class="footer__nav-heading">Rechtliches</p>
				<a href="/datenschutz" class="footer__nav-link">Datenschutz</a>
				<a href="/impressum" class="footer__nav-link">Impressum</a>
				<a href="/kontakt" class="footer__nav-link">Kontakt</a>
			</nav>
		</div>

		<div class="footer__copyright">
			<p>Copyright © {year}</p>
			<p>All rights reserved.</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		width: 100%;
		background-color: var(--color-primary);
		padding-block: 3.25em;
	}

	.footer__inner {
		display: flex;
		flex-direction: column;
		gap: 3em;
	}

	.footer__links {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2em;
		flex-wrap: wrap;
	}

	.footer__logo {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
	}

	.footer__logo-icon {
		position: relative;
		display: inline-block;
		width: 1.875em;
		height: 1.875em;
		flex-shrink: 0;
	}

	.footer__logo-shape {
		position: absolute;
	}

	.footer__logo-shape--a,
	.footer__logo-shape--c {
		filter: brightness(0) invert(1);
	}

	.footer__logo-shape--a {
		left: 0.791em;
		top: 0.768em;
		width: 1em;
		height: 1em;
		z-index: 1;
	}

	.footer__logo-shape--b {
		left: 0.187em;
		top: 0.163em;
		width: 1.546em;
		height: 1.545em;
		z-index: 2;
	}

	.footer__logo-shape--c {
		left: 0.129em;
		top: 0.104em;
		width: 1.002em;
		height: 1.003em;
		z-index: 3;
	}

	.footer__logo-text {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 1.25em;
		color: var(--color-text-white);
	}

	.footer__nav {
		display: flex;
		flex-direction: column;
		gap: 1em;
	}

	.footer__nav-heading {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 1em;
		line-height: 1.5;
		color: var(--color-text-white);
	}

	.footer__nav-link {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 1em;
		line-height: 1.5;
		color: var(--color-neutral-3);
		text-decoration: none;
	}

	.footer__nav-link:hover {
		color: var(--color-text-white);
	}

	.footer__copyright {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 1em;
		line-height: 1.5;
	}

	.footer__copyright p:first-child {
		color: var(--color-neutral-3);
	}

	.footer__copyright p:last-child {
		color: #909090;
	}

	@media (max-width: 767px) {
		.footer__copyright {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5em;
		}
	}
</style>
