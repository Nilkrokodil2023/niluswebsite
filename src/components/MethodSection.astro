---
const months = ["JANUAR", "FEBRUAR", "MÄRZ", "APRIL", "MAI"];
---

<section class="method" id="methode">
	<div class="method__inner container">
		<h2 class="method__headline">Die bewährte <span class="method__accent">Methode</span></h2>

		<div class="method__steps">
			<!-- Schritt 1 -->
			<div class="method__step">
				<div class="method__step-text">
					<span class="method__tag">Schritt 1</span>
					<h3 class="method__step-title">Zielgruppenanalyse</h3>
					<p class="method__step-desc">
						Als studierte Soziologin habe ich gelernt, menschliches Verhalten zu analysieren und diese Insights im Marketing anzuwenden. Ich analysiere die Wünsche und Probleme deiner Zielgruppe ganz genau und bringe sie auf deiner Verkaufsseite zum Ausdruck. Das Ziel: jeden Tag hochwertige Anfragen von kaufbereiten Kunden.
					</p>
				</div>
				<div class="method__visual">
					<div class="method__card method__card--single">
						<p class="method__card-title">Deine Zielgruppe</p>
						<div class="method__card-placeholder">
							<div class="method__icon-row">
								<span class="method__icon-btn method__icon-btn--float" style="animation-delay: 0s" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" fill="currentColor"/></svg>
								</span>
								<span class="method__icon-btn method__icon-btn--float" style="animation-delay: 0.3s" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" fill="currentColor"/></svg>
								</span>
							</div>
							<div class="method__icon-row">
								<span class="method__icon-btn method__icon-btn--float" style="animation-delay: 0.6s" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 12a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zm7 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 20c0-3 3-5.5 7-5.5s7 2.5 7 5.5v1H2v-1zm14-4.2c2.9.3 5 2.3 5 4.7v.5h-4v-.5c0-1.6-.4-3-1-4.2z" fill="currentColor"/></svg>
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Schritt 2 -->
			<div class="method__step method__step--reverse">
				<div class="method__step-text">
					<span class="method__tag">Schritt 2</span>
					<h3 class="method__step-title">Erstellung deiner Verkaufsmaschine</h3>
					<p class="method__step-desc">
						Ich erstelle deine Verkaufsseite & Werbeanzeigen – zielgruppengenau, verkaufspsychologisch fundiert und ohne verbranntes Budget. Jeder Euro arbeitet dafür, dass kaufbereite Interessenten auf deiner Landingpage landen und dir eine Anfrage senden.
					</p>
				</div>
				<div class="method__visual">
					<div class="method__card method__card--single">
						<p class="method__card-title">Dein Fundament</p>
						<div class="method__card-glyph" data-cursor-click>
							<svg class="method__glyph-icon" data-cursor-img viewBox="0 0 100 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
								<rect x="4" y="4" width="92" height="72" rx="8" stroke="var(--color-accent)" stroke-width="4"/>
								<line x1="4" y1="24" x2="96" y2="24" stroke="var(--color-accent)" stroke-width="4"/>
								<circle cx="16" cy="14" r="2.5" fill="var(--color-accent)"/>
								<circle cx="26" cy="14" r="2.5" fill="var(--color-accent)"/>
								<circle cx="36" cy="14" r="2.5" fill="var(--color-accent)"/>
								<rect x="16" y="36" width="34" height="8" rx="4" fill="var(--color-accent)"/>
								<rect x="16" y="52" width="26" height="16" rx="8" fill="var(--color-accent)"/>
								<path d="M54 40L54 72L61 65.5L66.5 76L72 73.2L66.5 62.5L78 62.5Z" fill="var(--color-accent)"/>
							</svg>
							<svg class="method__sparkle" data-sparkle viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 0 L14.2 9.8 L24 12 L14.2 14.2 L12 24 L9.8 14.2 L0 12 L9.8 9.8 Z" fill="white"/>
							</svg>
						</div>
					</div>
				</div>
			</div>

			<!-- Schritt 3 -->
			<div class="method__step">
				<div class="method__step-text">
					<span class="method__tag">Schritt 3</span>
					<h3 class="method__step-title">Optimierung &amp; Omnipräsenz</h3>
					<p class="method__step-desc">
						Es kommen laufend neue Anfragen rein – aber das war erst der Anfang. In der Optimierungsphase verbessern wir Conversionrate und Leadqualität immer weiter und skalieren deine Kampagnen Schritt für Schritt, bis du in deinem Markt omnipräsent bist.
					</p>
				</div>
				<div class="method__visual">
					<div class="method__card method__card--single">
						<p class="method__card-title">Dein Wachstum</p>
						<div class="method__chart">
							<svg class="method__chart-line" viewBox="0 0 276 140" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" aria-hidden="true">
								<path data-chart-path d="M2 138H59.7385C62.4534 138 64.983 136.623 66.4569 134.343L111.183 65.1568C112.657 62.8769 115.187 61.5 117.902 61.5H178.291C181.081 61.5 183.67 60.0462 185.122 57.6637L216.712 5.83629C218.164 3.45376 220.753 2 223.543 2H274" stroke="#E6FF02" stroke-width="4" stroke-linecap="round"/>
							</svg>
							<div class="method__chart-months">
								{months.map((m) => <span>{m}</span>)}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	function initChartDraw() {
		const paths = document.querySelectorAll<SVGPathElement>("[data-chart-path]");
		if (!paths.length) return;

		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		paths.forEach((path) => {
			const length = path.getTotalLength();

			if (reduce) {
				gsap.set(path, { clearProps: "all" });
				return;
			}

			gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });

			ScrollTrigger.create({
				trigger: path,
				start: "top 85%",
				once: true,
				onEnter: () =>
					gsap.to(path, {
						strokeDashoffset: 0,
						duration: 1.2,
						ease: "power2.out",
					}),
			});
		});

		ScrollTrigger.refresh();
	}

	function initCursorClick() {
		const containers = document.querySelectorAll<HTMLElement>("[data-cursor-click]");
		if (!containers.length) return;

		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (reduce) return;

		containers.forEach((container) => {
			const img = container.querySelector<HTMLElement>("[data-cursor-img]");
			const sparkle = container.querySelector<SVGElement>("[data-sparkle]");
			if (!img || !sparkle) return;

			ScrollTrigger.create({
				trigger: container,
				start: "top 85%",
				once: true,
				onEnter: () => {
					const tl = gsap.timeline({ repeat: -1, repeatDelay: 1.5 });
					tl.to(img, { scale: 0.97, duration: 0.12, ease: "power1.out" })
						.to(img, { scale: 1, duration: 0.2, ease: "power1.out" })
						.to(sparkle, { scale: 1, opacity: 1, duration: 0.25, ease: "back.out(3)" }, "<")
						.to(sparkle, { scale: 0.6, opacity: 0, duration: 0.35, ease: "power1.in" }, "+=0.2");
				},
			});
		});

		ScrollTrigger.refresh();
	}

	initChartDraw();
	initCursorClick();
</script>

<style>
	.method {
		width: 100%;
		background-color: var(--color-neutral-2);
		padding-block: 5em;
		position: relative;
		overflow: clip;
	}

	.method__inner {
		display: flex;
		flex-direction: column;
		gap: 4.75em;
	}

	.method__headline {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 3.75em;
		line-height: 1.2;
		letter-spacing: -1.5px;
		color: var(--color-neutral-7);
		text-align: center;
	}

	.method__accent {
		color: var(--color-accent);
	}

	.method__steps {
		display: flex;
		flex-direction: column;
		gap: 5em;
	}

	.method__step {
		display: flex;
		align-items: center;
		gap: 2.5em;
	}

	.method__step--reverse {
		flex-direction: row-reverse;
	}

	.method__step-text {
		flex: 1 0 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25em;
	}

	.method__tag {
		display: inline-flex;
		align-items: center;
		padding: 0.75em 2em;
		background-color: var(--color-accent);
		border-radius: var(--radius-xl);
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 1em;
		line-height: 1.5;
		color: var(--color-primary);
	}

	.method__step-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 3em;
		line-height: 1.167;
		letter-spacing: -1.2px;
		color: var(--color-primary);
		max-width: 10.5em;
	}

	.method__step-desc {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 1em;
		line-height: 1.5;
		letter-spacing: -0.128px;
		color: var(--color-neutral-1);
		max-width: 29.75em;
	}

	.method__visual {
		flex: 1 0 0;
		position: relative;
		height: 31.25em;
		background-color: var(--color-primary);
		border-radius: var(--radius-lg);
		overflow: clip;
	}

	.method__card {
		position: absolute;
		width: 20em;
		background-color: white;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 1em 0.5em 0.5em;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1em;
	}

	.method__card--single {
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
	}

	.method__card--back {
		top: 8%;
		left: 4%;
	}

	.method__card--front {
		top: 42%;
		left: 46%;
	}

	.method__card-title {
		width: 100%;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 1.25em;
		line-height: 1.4;
		letter-spacing: -0.5px;
		color: var(--color-primary);
		text-align: left;
	}

	.method__card-placeholder {
		width: 100%;
		height: 18em;
		background-color: var(--color-primary);
		border-radius: var(--radius-md);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1em;
	}

	.method__icon-row {
		display: flex;
		gap: 1em;
	}

	.method__icon-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.5em;
		height: 3.5em;
		background-color: var(--color-accent);
		border-radius: var(--radius-md);
		color: var(--color-primary);
	}

	.method__icon-btn svg {
		width: 1.5em;
		height: 1.5em;
	}

	@media (prefers-reduced-motion: no-preference) {
		.method__icon-btn--float {
			animation: icon-float 3s ease-in-out infinite;
		}
	}

	@keyframes icon-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-0.5em);
		}
	}

	.method__card-glyph {
		position: relative;
		width: 100%;
		height: 18em;
		background-color: var(--color-primary);
		border-radius: var(--radius-md);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.method__glyph-icon {
		width: 9em;
		height: auto;
	}

	.method__sparkle {
		position: absolute;
		top: 48%;
		left: 53%;
		width: 1.75em;
		height: 1.75em;
		transform: scale(0);
		opacity: 0;
		pointer-events: none;
	}

	.method__chart {
		width: 100%;
		background-color: var(--color-primary);
		border-radius: var(--radius-md);
		padding: 1em;
		display: flex;
		flex-direction: column;
		gap: 2.5em;
	}

	.method__chart-line {
		width: 100%;
		height: auto;
		display: block;
	}

	.method__chart-months {
		display: flex;
		gap: 0.25em;
		justify-content: space-between;
	}

	.method__chart-months span {
		flex: 1 0 0;
		text-align: center;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 0.75em;
		letter-spacing: -0.096px;
		color: var(--color-text-secondary);
	}

	@media (max-width: 991px) {
		.method__headline {
			font-size: 3em;
		}

		.method__step,
		.method__step--reverse {
			flex-direction: column;
		}

		.method__step-text,
		.method__visual {
			width: 100%;
		}

		.method__card {
			position: static;
			transform: none;
			width: 100%;
			margin-bottom: 1em;
		}

		.method__visual {
			height: auto;
			padding: 1.5em;
			display: flex;
			flex-direction: column;
			gap: 1em;
		}
	}

	@media (max-width: 767px) {
		.method {
			padding-block: 3em;
		}

		.method__headline {
			font-size: 2.25em;
		}

		.method__steps {
			gap: 3em;
		}

		.method__step-title {
			font-size: 2em;
		}
	}
</style>
